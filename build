#!/usr/bin/env bash
# Build the next patch version of the image, push it (+ :latest) to the
# registry, and record the new version in package.json. Usage: ./build
set -euo pipefail

cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

IMAGE=registry.digitalsorcery.net/yellat
CURRENT="$(sed -nE 's/^  "version": "([^"]+)".*/\1/p' package.json)"
if [[ -z "${CURRENT}" ]]; then
  echo "error: could not read version from package.json" >&2
  exit 1
fi
NEXT="${CURRENT%.*}.$((${CURRENT##*.} + 1))"

podman build --pull=always --format docker -f Containerfile -t "$IMAGE:$NEXT" -t "$IMAGE:latest" .
podman push "$IMAGE:$NEXT"
podman push "$IMAGE:latest"
sed -i -E "s/^(  \"version\": \")[^\"]+/\1${NEXT}/" package.json

echo "Pushed $IMAGE:$NEXT"
